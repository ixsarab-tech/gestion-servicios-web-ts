{
  "name": "gestion-servicios-web-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestión de servicios técnicos (taller, field service, facturación, BI) — Next.js 16 + Prisma + MySQL multi-tenant",
  "author": "Jorge Prado",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true});require('fs').rmSync('node_modules/.cache',{recursive:true,force:true})\"",
    "db:up": "docker compose -f docker/mysql/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/mysql/docker-compose.yml down",
    "db:logs": "docker compose -f docker/mysql/docker-compose.yml logs -f mysql",
    "db:ps": "docker compose -f docker/mysql/docker-compose.yml ps",
    "db:nuke": "docker compose -f docker/mysql/docker-compose.yml down -v",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "db:generate": "node scripts/with-env.mjs prisma generate",
    "db:format": "node scripts/with-env.mjs prisma format",
    "db:studio": "node scripts/with-env.mjs prisma studio",
    "db:seed": "node scripts/with-env.mjs tsx prisma/seed/seed-base.ts",
    "db:seed:catalogos": "node scripts/with-env.mjs tsx prisma/seed/seed-catalogos.ts",
    "db:seed:demo-clientes": "node scripts/with-env.mjs tsx prisma/seed/seed-demo-clientes.ts",
    "db:reset": "pnpm db:nuke && pnpm db:up && timeout /t 15 /nobreak >nul && pnpm db:migrate --name init && pnpm db:seed && pnpm db:seed:catalogos && pnpm db:seed:demo-clientes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/with-env.mjs vitest run --config vitest.integration.config.mts",
    "test:all": "pnpm test && pnpm test:integration",
    "test:e2e": "playwright test",
    "check:audit": "tsx scripts/check-audit.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.57.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@prisma/config": "^7.10.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/lib-dom": "npm:@types/web@0.0.356",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
