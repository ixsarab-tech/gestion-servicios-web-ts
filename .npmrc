# # Falla si Node no cumple "engines" de package.json
# engine-strict=true

# # pnpm no modifica el lockfile salvo que sea necesario
# prefer-frozen-lockfile=true

# # Auto-instala peer dependencies (default pnpm 8+, explícito aquí)
# auto-install-peers=true

# # No romper si hay peer deps mal declaradas (útil con Next + React 19)
# strict-peer-dependencies=false

# # Al añadir un paquete, guardar "1.2.3" en lugar de "^1.2.3"
# # (revertimos a caret en un comando posterior si prefieres rangos)
# save-exact=false
