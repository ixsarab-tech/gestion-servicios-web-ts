# ═══════════════════════════════════════════════════════════════
# PLANTILLA DE VARIABLES — copiar a .env.local y rellenar
# ═══════════════════════════════════════════════════════════════

# ─── Aplicación ───
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Gestión Servicios Web TS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Base de datos ───
# Usuario de la app (DML: SELECT/INSERT/UPDATE/DELETE)
DATABASE_URL="mysql://app_user:REEMPLAZAR@localhost:3307/gestion_servicio_web"
# Usuario de migraciones (DDL) — solo para prisma migrate
MIGRATE_DATABASE_URL="mysql://migrator_user:REEMPLAZAR@localhost:3307/gestion_servicio_web"
# Base de datos shadow (para migrate dev)
SHADOW_DATABASE_URL="mysql://migrator_user:REEMPLAZAR@localhost:3307/gestion_servicio_web_shadow"

# ─── Autenticación (Auth.js v5) ───
# Generar con: openssl rand -base64 32
AUTH_SECRET="REEMPLAZAR"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ─── Seeds ───
SEED_PASSWORD="REEMPLAZAR"
SEED_LOCALE="es-NI"
SEED_FAKER_SEED="20260101"

# ─── Observabilidad (opcional) ───
LOG_LEVEL="debug"

# ─── Servicios externos (se completan más adelante) ───
# WHATSAPP_API_URL=""
# WHATSAPP_API_TOKEN=""
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""